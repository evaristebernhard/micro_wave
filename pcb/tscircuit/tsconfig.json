{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "tscircuit"
    ]
  },
  "include": [
    "index*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
